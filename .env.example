# Root environment configuration for Recipe Creator

# Backend settings (overrides can also be placed in backend/.env)
SECRET_KEY=dev-secret-key
JWT_SECRET_KEY=jwt-dev-secret

# Use SQLite by default for local development
DATABASE_URL=sqlite:///app.db

# Optional: OpenAI key for AI-enhanced recipes
OPENAI_API_KEY=your-openai-api-key

# CORS origins for the API. Comma-separated list.
# For local Docker deployment, the frontend runs on http://localhost.
CORS_ORIGINS=http://localhost

# Docker Hub username used for pulling images in docker-compose
DOCKERHUB_USERNAME=your-dockerhub-username


