            "description": "GET /api/products/ — returns the full ingredient catalog. No auth required."
          },
          "response": []
        },
        {
          "name": "Search Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
