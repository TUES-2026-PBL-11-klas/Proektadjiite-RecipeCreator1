# Backend-specific environment configuration

SECRET_KEY=dev-secret-key
JWT_SECRET_KEY=jwt-dev-secret

# Database connection string
# For local development inside Docker you can keep SQLite, or point to Postgres.
DATABASE_URL=sqlite:///app.db

# Optional: OpenAI key for AI-enhanced recipes
OPENAI_API_KEY=your-openai-api-key

# CORS origins for the API. Comma-separated list.
# When running via docker-compose, the frontend is served from http://localhost.
CORS_ORIGINS=http://localhost

